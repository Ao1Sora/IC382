#usda 1.0
(
    defaultPrim = "World"
    subLayers = [
        @final_wheeltec_with_scene.usd@
    ]
)

over "World" (
    prepend apiSchemas = ["MaterialBindingAPI"]
)
{
    rel material:binding = </World/IC382_HPC_Material> (
        bindMaterialAs = "strongerThanDescendants"
    )

    def Material "IC382_HPC_Material"
    {
        token outputs:surface.connect = </World/IC382_HPC_Material/Shader.outputs:surface>

        def Shader "Shader"
        {
            uniform token info:id = "UsdPreviewSurface"
            color3f inputs:diffuseColor = (0.65, 0.68, 0.72)
            float inputs:roughness = 0.8
            token outputs:surface
        }
    }

    over "senior_diff_robot_scaled"
    {
        over "senior_diff_robot"
        {
            over "senior_diff_robot"
            {
                over "Geometry"
                {
                    over "base_link"
                    {
                        over "laser_link"
                        {
                            def Camera "Lidar"
                            {
                                custom string cameraSensorType = "lidar"
                                float2 clippingRange = (0.05, 1000000)
                                custom string sensorModelConfig = "SLAMTEC/RPLIDAR_S2E"
                                custom string sensorModelPluginName = "omni.sensors.nv.lidar.lidar_core.plugin"
                            }
                        }
                    }
                }
            }
        }
    }
}

